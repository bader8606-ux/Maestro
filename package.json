{
  "name": "maestro-sponsor-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:api": "node --test tests/api.test.mjs",
    "test:ui": "node --test tests/ui.test.mjs",
    "format": "prettier --write src server tests *.json *.ts index.html README.md"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "express": "5.2.1",
    "lucide-react": "0.468.0",
    "multer": "2.4.0",
    "pdfkit": "0.20.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "6.1.1",
    "playwright-core": "1.63.0",
    "prettier": "3.9.9",
    "typescript": "5.9.2",
    "vite": "8.3.2"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
